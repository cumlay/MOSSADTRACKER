{
  "name": "mossad-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mossad Tracker — Hive (Bedrock) player activity tracker: who is playing, when, and what.",
  "author": "andy.bangerter10@gmail.com",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch --import tsx scripts/dev-api.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --import tsx src/server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.server.json",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "discord.js": "^14.27.0",
    "fastify": "^5.2.1",
    "node-sqlite3-wasm": "^0.8.30",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.66.0",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.4.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.14"
  }
}
