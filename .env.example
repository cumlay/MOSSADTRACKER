# Copy to .env — that copy is gitignored, this one is not, so never put a real
# token here. Every value is optional.

# Discord bot. Without a token the bot simply never starts.
# The application also needs the MESSAGE CONTENT intent enabled in the Discord
# developer portal, otherwise incoming messages arrive with an empty body.
DISCORD_TOKEN=

# Command prefix, "." by default: .addTracker / .removeTracker / .trackerList
DISCORD_PREFIX=.

# Restrict the bot to a single channel. Leave empty to answer anywhere it can read.
DISCORD_CHANNEL_ID=

# Ports. API_PORT wins over PORT; in dev, PORT belongs to Vite.
# API_PORT=3717
