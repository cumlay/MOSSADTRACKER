# Copy to .env — that copy is gitignored, this one is not, so never put a real
# token here. Every value is optional. On the corlay server these go in
# /etc/corlay/tracker.env instead. Full walkthrough: docs/discord-bot.md

# Discord bot. Without a token the bot simply never starts.
DISCORD_TOKEN=

# Your Discord server's ID: slash commands are registered there and show up
# instantly. Without it they are registered globally, which can take a while.
DISCORD_GUILD_ID=

# Restrict the commands to a single channel. Leave empty to answer anywhere.
DISCORD_CHANNEL_ID=

# Where the bot posts an embed when a tracked Hive player starts playing.
# Falls back to DISCORD_CHANNEL_ID; with neither set, the bot posts no alerts.
DISCORD_ALERT_CHANNEL_ID=

# Legacy text commands (.addTracker / .removeTracker / .trackerList), off when
# empty. Setting a prefix requires the MESSAGE CONTENT privileged intent in the
# developer portal, or the bot is refused at login.
DISCORD_PREFIX=

# Shared secret the in-game client (Oriel) proves itself with, so it can read the
# watchlist and report who is standing in your Hive lobby. nginx cannot vouch for a
# program outside the browser, so it carries this instead. Empty = those two routes
# stay closed. Generate one with: openssl rand -hex 32
CLIENT_TOKEN=

# Ports. API_PORT wins over PORT; in dev, PORT belongs to Vite.
# API_PORT=3717
